---
import type { MarkdownHeading } from "astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter(
	(heading) => heading.depth === 2 || heading.depth === 3,
);
---

{
	tocHeadings.length > 0 && (
		<aside class="hidden lg:sticky lg:top-8 lg:block lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto">
			<p class="text-sm font-bold text-foreground">目次</p>
			<ul class="mt-3 list-none space-y-1 border-l border-border p-0 text-sm">
				{tocHeadings.map((heading) => (
					<li>
						<a
							href={`#${heading.slug}`}
							data-toc-link={heading.slug}
							class:list={[
								"-ml-px block border-l-2 border-transparent py-1 text-muted no-underline hover:text-accent",
								heading.depth === 3 ? "pl-6" : "pl-3",
							]}
						>
							{heading.text}
						</a>
					</li>
				))}
			</ul>
		</aside>
	)
}

<script>
	const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");

	const ACTIVE_CLASSES = ["border-accent", "text-accent", "font-medium"];
	const INACTIVE_CLASSES = ["border-transparent", "text-muted"];

	const setActive = (slug: string) => {
		for (const link of links) {
			const isActive = link.dataset.tocLink === slug;
			link.classList.remove(...(isActive ? INACTIVE_CLASSES : ACTIVE_CLASSES));
			link.classList.add(...(isActive ? ACTIVE_CLASSES : INACTIVE_CLASSES));
		}
	};

	// 見出しが読了ライン(ビューポート上端からREAD_LINE_PX)を通過したら、
	// その見出しを現在地としてハイライトする。
	const headingElements = Array.from(links, (link) =>
		document.getElementById(link.dataset.tocLink ?? ""),
	).filter((el): el is HTMLElement => el !== null);

	const READ_LINE_PX = 100;

	const updateActive = () => {
		let current: HTMLElement | undefined;
		for (const el of headingElements) {
			if (el.getBoundingClientRect().top <= READ_LINE_PX) {
				current = el;
			}
		}
		if (current) setActive(current.id);
	};

	window.addEventListener("scroll", updateActive, { passive: true });
	updateActive();
</script>
