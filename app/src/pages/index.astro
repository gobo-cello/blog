---
import { getCollection } from "astro:content";
import CategoryTabs from "../components/CategoryTabs.astro";
import PostList from "../components/PostList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoriesWithPosts } from "../lib/categories";
import { sortPostsByDateDesc } from "../lib/sort";

const posts = sortPostsByDateDesc(
	await getCollection("posts", ({ data }) => !data.draft),
);
const categories = categoriesWithPosts(posts);
---

<BaseLayout title="ごぼうのブログ" description="ごぼうのブログです。">
	<h1 class="text-2xl font-bold">最新の記事</h1>
	<CategoryTabs categories={categories} active={null} />
	<PostList posts={posts} />
</BaseLayout>
