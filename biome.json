{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"linter": {
		"domains": {
			"project": "recommended",
			"react": "recommended",
			"types": "recommended"
		},
		"rules": {
			"suspicious": {
				"noImportCycles": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.html"],
			"html": {
				"formatter": {
					"enabled": true,
					"selfCloseVoidElements": "always"
				}
			}
		}
	]
}
