---
import type { Category } from "../content.config";
import { CATEGORY_COLOR_CLASS } from "../lib/categoryColor";

interface Props {
	category: Category;
}

const { category } = Astro.props;
---

<a
	href={`/categories/${category}/`}
	class="flex items-center gap-1.5 text-muted no-underline hover:text-accent"
>
	<span
		aria-hidden="true"
		class:list={[
			"inline-block h-2 w-2 rounded-full",
			CATEGORY_COLOR_CLASS[category].dot,
		]}
	/>
	{category}
</a>
