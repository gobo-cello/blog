---
import { getCollection } from "astro:content";
import CategoryTabs from "../../components/CategoryTabs.astro";
import PostList from "../../components/PostList.astro";
import type { Category } from "../../content.config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoriesWithPosts } from "../../lib/categories";
import { sortPostsByDateDesc } from "../../lib/sort";

export async function getStaticPaths() {
	const posts = await getCollection("posts", ({ data }) => !data.draft);
	const categories = categoriesWithPosts(posts);
	return categories.map((category) => ({
		params: { category },
		props: {
			posts: sortPostsByDateDesc(
				posts.filter((post) => post.data.category === category),
			),
			categories,
		},
	}));
}

const { category } = Astro.params;
const { posts, categories } = Astro.props;
/** getStaticPaths が categoriesWithPosts の結果からのみ params を生成するため、実行時は必ず Category 型の値になる。 */
const active = category as Category;
---

<BaseLayout
	title={`カテゴリ: ${category}`}
	description={`${category}カテゴリの記事一覧です。`}
>
	<h1 class="text-2xl font-bold">最新の記事</h1>
	<CategoryTabs categories={categories} active={active} />
	<PostList posts={posts} />
</BaseLayout>
