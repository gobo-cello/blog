---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderTitleHtml } from "../lib/title";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="ごぼうのブログ" description="ごぼうのブログです。">
	<ul class="list-none divide-y divide-border p-0">
		{
			posts.map((post) => (
				<li class="py-4 first:pt-0">
					<a
						href={`/posts/${post.id}/`}
						class="text-lg font-semibold text-foreground no-underline hover:text-accent"
						set:html={renderTitleHtml(post.data.title)}
					/>
					<div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-muted">
						<p>{post.data.date.toISOString().slice(0, 10)}</p>
						<span aria-hidden="true">·</span>
						<a
							href={`/categories/${post.data.category}/`}
							class="text-muted no-underline hover:text-accent"
						>
							{post.data.category}
						</a>
					</div>
					{post.data.tags.length > 0 && (
						<ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
							{post.data.tags.map((tag) => (
								<li>
									<a
										href={`/tags/${tag}/`}
										class="rounded-full border border-border px-3 py-1 text-sm text-muted no-underline hover:border-accent hover:text-accent"
									>
										#{tag}
									</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ul>
</BaseLayout>
